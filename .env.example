# Phase 2 provider configuration. Disabled by default; no silent provider failover.
# Copy this file to .env for local configuration; never commit or share real values.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
MODEL_PROVIDER=disabled
MAX_REPORT_CHARS=50000
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=2

# Anthropic direct API (backend only; never use NEXT_PUBLIC_* for secrets)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# Verifier must name a distinct model ID; used only for independent fact/claim checks.
ANTHROPIC_MODEL=
ANTHROPIC_VERIFIER_MODEL=

# OpenRouter (backend only; explicitly select MODEL_PROVIDER=openrouter to enable)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_VERIFIER_MODEL=

# Ollama (no key needed by default). The endpoint may be remote; verify network trust/control.
# Compose defaults to the host gateway; for local FastAPI, set http://127.0.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_VERIFIER_MODEL=

# Local Next.js → FastAPI route (overridden to service DNS in Compose)
BACKEND_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
