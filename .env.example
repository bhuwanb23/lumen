# Phase 0 config only: all model integrations are unimplemented and disabled.
# Copy this file to .env for local configuration; never commit or share real values.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
MODEL_PROVIDER=disabled

# Anthropic direct API (backend only; never use NEXT_PUBLIC_* for secrets)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenRouter (backend only; provider/model must be selected later)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Ollama (optional local model service; no key needed by default)
# Compose defaults to the host gateway; for local FastAPI, override to http://127.0.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# Local Next.js → FastAPI route (overridden to service DNS in Compose)
BACKEND_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
