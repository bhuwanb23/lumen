{
  "$defs": {
    "ApprovedQuestion": {
      "additionalProperties": false,
      "properties": {
        "cited_fact_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Cited Fact Ids",
          "type": "array"
        },
        "question_id": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "Question Id",
          "type": "string"
        },
        "review_status": {
          "const": "approved",
          "default": "approved",
          "title": "Review Status",
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 5,
          "pattern": "\\?\\s*$",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "text",
        "cited_fact_ids"
      ],
      "title": "ApprovedQuestion",
      "type": "object"
    },
    "ClaimCitation": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/EvidenceSpan"
        },
        "fact_id": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "Fact Id",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "evidence"
      ],
      "title": "ClaimCitation",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Zero-based Python Unicode-codepoint offsets; end is exclusive; no normalization.",
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "quote",
        "start",
        "end"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "ExtractedFact": {
      "additionalProperties": false,
      "description": "A report fact or an explicit absence/ambiguity marker with its provenance.",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "fact_id": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "Fact Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "report_type",
            "primary_site",
            "cancer_type",
            "histology",
            "grade",
            "stage",
            "margins",
            "lymph_nodes",
            "lymphovascular_invasion",
            "biomarkers",
            "molecular_test_status",
            "distant_metastasis",
            "tumor_size",
            "other_findings"
          ],
          "title": "Field",
          "type": "string"
        },
        "status": {
          "enum": [
            "stated",
            "not_stated",
            "unclear"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "fact_id",
        "field",
        "value",
        "status",
        "evidence"
      ],
      "title": "ExtractedFact",
      "type": "object"
    },
    "SupportedClaim": {
      "additionalProperties": false,
      "description": "Public response form; unsupported/pending states are not representable here.",
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/ClaimCitation"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "claim_id": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verification": {
          "const": "supported",
          "default": "supported",
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "citations"
      ],
      "title": "SupportedClaim",
      "type": "object"
    }
  },
  "$id": "https://lumen.invalid/contracts/v1.0.0/analysis_response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/SupportedClaim"
      },
      "maxItems": 20,
      "title": "Claims",
      "type": "array"
    },
    "disclaimer": {
      "const": "Lumen explains report wording; it is not medical advice. It does not diagnose, predict outcomes, or recommend treatment. Confirm meaning with your care team.",
      "default": "Lumen explains report wording; it is not medical advice. It does not diagnose, predict outcomes, or recommend treatment. Confirm meaning with your care team.",
      "title": "Disclaimer",
      "type": "string"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/ExtractedFact"
      },
      "maxItems": 100,
      "title": "Facts",
      "type": "array"
    },
    "language": {
      "const": "en",
      "title": "Language",
      "type": "string"
    },
    "omitted_claim_count": {
      "minimum": 0,
      "title": "Omitted Claim Count",
      "type": "integer"
    },
    "questions_for_care_team": {
      "items": {
        "$ref": "#/$defs/ApprovedQuestion"
      },
      "maxItems": 8,
      "title": "Questions For Care Team",
      "type": "array"
    },
    "reading_level": {
      "enum": [
        "simple",
        "standard",
        "detailed"
      ],
      "title": "Reading Level",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "no_supported_claims"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "language",
    "reading_level",
    "facts",
    "claims",
    "questions_for_care_team",
    "omitted_claim_count"
  ],
  "title": "AnalysisResponse",
  "type": "object",
  "x-contract-version": "1.0.0"
}
